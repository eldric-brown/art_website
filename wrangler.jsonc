{
  // Cloudflare Pages 项目配置
  // 参考：https://developers.cloudflare.com/pages/functions/bindings/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "art-website",
  // 只发布 public/ 目录：否则仓库里的 wrangler.jsonc、schema.sql、.dev.vars 等会被当成静态资源公开
  "pages_build_output_dir": "public",
  "compatibility_date": "2025-09-01",

  // 数据库绑定：D1
  // 变量名 "DB" 会在函数里通过 context.env.DB 访问
  // 需要先在 Cloudflare Dashboard 创建 D1 数据库，再把 database_id 填进来
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "art-website-db",
      "database_id": "f05db7f6-8cd4-4797-8a40-51878494a73c"
    }
  ],

  // 图片采用外链方案（后台粘贴 HTTPS 图床链接），未绑定对象存储。
  // functions/api/admin/upload.js 与 functions/r2/[[key]].js 代码保留休眠，
  // 日后恢复 R2：创建 bucket 后在下方加回 r2_buckets 并重新部署即可。
  //   "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "art-website-images" }]
}
